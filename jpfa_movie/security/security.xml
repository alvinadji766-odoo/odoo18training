<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_movie" model="ir.module.category">
        <field name="name">Movie Catalog</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_movie_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_movie"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_movie_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_movie"/>
        <field name="implied_ids" eval="[(4, ref('group_movie_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- User: hanya boleh edit/hapus review miliknya sendiri -->
    <record id="rule_movie_review_user_own" model="ir.rule">
        <field name="name">Movie Review: user edits own reviews</field>
        <field name="model_id" ref="model_movie_review"/>
        <field name="groups" eval="[(4, ref('group_movie_user'))]"/>
        <field name="domain_force">[('reviewer_id', '=', user.id)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Manager: semua review -->
    <record id="rule_movie_review_manager_all" model="ir.rule">
        <field name="name">Movie Review: manager all</field>
        <field name="model_id" ref="model_movie_review"/>
        <field name="groups" eval="[(4, ref('group_movie_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
