<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_movie_review_list" model="ir.ui.view">
        <field name="name">movie.review.list</field>
        <field name="model">movie.review</field>
        <field name="arch" type="xml">
            <list>
                <field name="movie_id"/>
                <field name="reviewer_id"/>
                <field name="score"/>
                <field name="comment"/>
            </list>
        </field>
    </record>
    <record id="view_movie_review_form" model="ir.ui.view">
        <field name="name">movie.review.form</field>
        <field name="model">movie.review</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="movie_id"/>
                        <field name="reviewer_id"/>
                        <field name="score"/>
                        <field name="comment"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_movie_review_search" model="ir.ui.view">
        <field name="name">movie.review.search</field>
        <field name="model">movie.review</field>
        <field name="arch" type="xml">
            <search>
                <field name="movie_id"/>
                <field name="reviewer_id"/>
                <field name="comment"/>
                <filter name="filter_top_score" string="Masterpiece (Score &gt;= 8)" domain="[('score', '&gt;=', 8)]"/>
                <filter name="filter_low_score" string="Poor (Score &lt;= 4)" domain="[('score', '&lt;=', 4)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_movie" string="Movie" context="{'group_by': 'movie_id'}"/>
                    <filter name="group_reviewer" string="Reviewer" context="{'group_by': 'reviewer_id'}"/>
                    <filter name="group_score" string="Score" context="{'group_by': 'score'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_movie_review" model="ir.actions.act_window">
        <field name="name">Reviews</field>
        <field name="res_model">movie.review</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_movie_review_search"/>
    </record>
</odoo>
