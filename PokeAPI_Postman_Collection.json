    {
      "name": "2. Odoo Movie API (Internal Auth & Webhook)",
      "description": "Endpoint internal Odoo dengan Autentikasi API Key & Webhook",
      "item": [
        {
          "name": "GET Movies List (Authorized)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{odoo_api_key}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/movies?limit=10",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "movies"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET Movies List (Unauthorized Test)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/movies",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "movies"
              ]
            },
            "description": "Menguji penolakan HTTP 401 Unauthorized jika tanpa API Key"
          },
          "response": []
        },
        {
          "name": "POST Create Movie (Authorized)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{odoo_api_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Interstellar\",\n  \"duration\": 169,\n  \"release_date\": \"2014-11-07\",\n  \"synopsis\": \"When Earth becomes uninhabitable in the future, a farmer and ex-NASA pilot, Joseph Cooper, is tasked to pilot a spacecraft.\",\n  \"rating\": \"5\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/movies",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "movies"
              ]
            }
          },
          "response": []
        },
        {
          "name": "POST Webhook - Ping Health Check",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Webhook-Secret",
                "value": "{{webhook_secret}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"ping\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/webhook/movie",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "webhook",
                "movie"
              ]
            }
          },
          "response": []
        },
        {
          "name": "POST Webhook - Inbound Auto Review",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Webhook-Secret",
                "value": "{{webhook_secret}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"new_review\",\n  \"movie_id\": 1,\n  \"reviewer_name\": \"Postman Webhook Tester\",\n  \"score\": 5.0,\n  \"comment\": \"Automated review posted via Inbound Webhook!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/webhook/movie",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "webhook",
                "movie"
              ]
            }
          },
          "response": []
        }
      ]
    }
